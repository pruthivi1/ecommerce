# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins (the deployed/dev frontend URLs)
FRONTEND_URL=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=marketbridge
DATABASE_USER=marketbridge_app
DATABASE_PASSWORD=change-me
# Set to "true" only if your managed MySQL provider requires TLS (most do in production)
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay test-mode keys from https://dashboard.razorpay.com/app/keys
# Leave blank in an environment where payments are intentionally unconfigured —
# the payment routes will respond with a clear "payments not configured" error
# instead of fabricating a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary persistent image storage (optional; if unconfigured, files are saved locally under public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business rules — configurable rather than hardcoded in application code.
# Confirm actual values with the business/accounting owner before production use.
DEFAULT_GST_RATE=0.18
DEFAULT_COMMISSION_RATE=0.08
SHIPPING_FEE_PER_VENDOR=300

# Set true only in non-production environments to allow the demo role-switcher
# login endpoint. Must be false/unset in production.
ALLOW_DEMO_LOGIN=true
